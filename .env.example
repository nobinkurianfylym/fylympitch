NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_SITE_URL=https://fylympitch.netlify.app

# ── AI Engine providers (server-only, never use NEXT_PUBLIC_ prefix) ──────────
#
# GROQ_API_KEY — Primary inference provider.
# Groq runs on custom LPU hardware at ~400 tokens/second (vs ~70 for OpenAI).
# Use for: project analysis, opportunity profiling, semantic matching,
# obstacle detection, market intelligence, EP brief.
# Get a key at: https://console.groq.com
# If set, Groq is used for all inference. OpenAI is used only as a fallback
# or for web-search-enabled EP brief.
GROQ_API_KEY=gsk_...

# OPENAI_API_KEY — Fallback inference + web search EP brief.
# Required if OPENAI_WEB_SEARCH=true (uses gpt-4o-mini-search-preview
# to verify fund deadlines live before writing the EP brief).
# If unset AND GROQ_API_KEY is set, all AI runs on Groq without web search.
# If both unset, engine falls back to deterministic rule-based heuristics.
OPENAI_API_KEY=sk-...

# Set to "true" to enable live fund deadline verification in the EP brief.
# Requires OPENAI_API_KEY (Groq does not support web search).
OPENAI_WEB_SEARCH=false
